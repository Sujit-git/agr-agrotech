# AGR — Agrotech environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Backend (managed by Lovable Cloud; auto-populated in this project) ---
# Public browser values (safe to expose)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only values (never expose to the browser)
DATABASE_URL="postgresql://user:password@host:5432/database"
AUTH_SECRET="replace-with-a-long-random-value"

# --- Business configuration ---
# The admin account allowed to sign in at /admin/login
ADMIN_EMAIL="admin@example.com"
# Storage bucket used for product images
STORAGE_BUCKET="product-images"
# WhatsApp number with country code, no + or spaces
WHATSAPP_NUMBER="10000000000"

# --- Website contact-form email delivery via Gmail SMTP (server-only secrets) ---
# Use the Gmail account that will send website enquiries; no domain DNS verification is needed.
GMAIL_SMTP_USER="agragrotech@gmail.com"
# Create a Google App Password after enabling 2-Step Verification; never use your normal Gmail password.
GMAIL_SMTP_APP_PASSWORD="your-16-character-google-app-password"
# Default fallback only; Admin → Settings → Enquiry email is the live recipient.
CONTACT_EMAIL="agragrotech@gmail.com"
# Server function uses these to read the admin-configured recipient from site_settings.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-key"

# Production site URL, used for canonical links and the sitemap
PUBLIC_SITE_URL="https://example.com"
