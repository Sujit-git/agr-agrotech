# AGR — Agrotech environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Backend (managed by Lovable Cloud; auto-populated in this project) ---
# Public browser values (safe to expose)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only values (never expose to the browser)
DATABASE_URL="postgresql://user:password@host:5432/database"
AUTH_SECRET="replace-with-a-long-random-value"

# --- Business configuration ---
# The admin account allowed to sign in at /admin/login
ADMIN_EMAIL="admin@example.com"
# Storage bucket used for product images
STORAGE_BUCKET="product-images"
# WhatsApp number with country code, no + or spaces
WHATSAPP_NUMBER="10000000000"
# Default enquiry recipient; the Admin → Settings email field is the live source of truth.
CONTACT_EMAIL="agragrotech@gmail.com"

# --- Netlify contact-form email delivery ---
# Add these as Netlify environment variables. Never commit real credentials.
RESEND_API_KEY="re_your_resend_api_key"
# Must be a sender address/domain verified in Resend, e.g. Fruitly <enquiries@your-verified-domain.in>
RESEND_FROM_EMAIL="Fruitly <enquiries@your-verified-domain.in>"
# Server runtime access for reading the admin-managed site_settings email.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-publishable-key"
# Production site URL, used for canonical links and the sitemap
PUBLIC_SITE_URL="https://example.com"
