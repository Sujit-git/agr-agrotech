# AGR — Agrotech environment variables
# Copy to .env and fill in real values. NEVER commit .env.

# --- Backend (managed by Lovable Cloud; auto-populated in this project) ---
# Public browser values (safe to expose)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"

# Server-only values (never expose to the browser)
DATABASE_URL="postgresql://user:password@host:5432/database"
AUTH_SECRET="replace-with-a-long-random-value"

# --- Business configuration ---
# The admin account allowed to sign in at /admin/login
ADMIN_EMAIL="admin@example.com"
# Storage bucket used for product images
STORAGE_BUCKET="product-images"
# WhatsApp number with country code, no + or spaces
WHATSAPP_NUMBER="10000000000"
CONTACT_EMAIL="hello@example.com"
# Production site URL, used for canonical links and the sitemap
PUBLIC_SITE_URL="https://example.com"
